import {
  Badge,
  Box,
  Button,
  Checkbox,
  Flex,
  IconButton,
  Image,
  Input,
  NumberInput,
  NumberInputField,
  Radio,
  RadioGroup,
  Select as NativeSelect,
  Stack,
  Text,
} from "@chakra-ui/react";
import {
  Select,
  chakraComponents,
  GroupBase,
  SelectComponentsConfig,
} from "chakra-react-select";
import { useEffect, useMemo, useState } from "react";
import { LuPlus, LuTrash2 } from "react-icons/lu";
import BoardCard from "../../components/layout/boardCard";
import {
  MATERIAL_INFOS,
  MATERIAL_TYPE,
} from "../../constants/enhance/material";
import {
  POTENTIAL_CRITERIA,
  POTENTIAL_GRADE,
  POTENTIAL_INFOS,
} from "../../constants/enhance/potential";
import {
  calcRollingMaterials,
  getPotentialIcon,
  isAddi,
  isSelectable,
} from "../../services/enhance/potential";
import {
  calcConditionInfos,
  calcProbabilityByConditions,
} from "../../services/enhance/potentialCondition";
import { usePotentialQuery } from "../../stores/characterApi";

const SELECTABLE_MATERIALS = (
  Object.keys(MATERIAL_INFOS) as MATERIAL_TYPE[]
).filter(isSelectable);
const GRADES = Object.values(POTENTIAL_GRADE);

interface GameOptionRow {
  id: string;
  name: string;
  value: number;
  userValue: number;
}

interface Candidate {
  id: string;
  label: string;
  materialType: MATERIAL_TYPE;
  level: number;
  part: string;
  doubleUpgrade: boolean;
  currentValue: number; // V_U
  legendaryValue: number; // V_L
  buyCost: number; // 제물 구입비
  extraCost: number; // 감정비 등 추가 비용
  pityConfirmedManual: boolean; // 그룹 없을 때만 사용
  options: GameOptionRow[];
  groupId?: string;
}

interface PityGroup {
  id: string;
  materialType: MATERIAL_TYPE;
  grade: POTENTIAL_GRADE;
  sharedGuarantee: number;
  targetId?: string;
}

interface OptionSelectItem {
  label: string;
  value: string;
  grades: Set<string>;
}

function createCandidate(): Candidate {
  return {
    id: Math.random().toString(36).slice(2),
    label: "새 장비",
    materialType: SELECTABLE_MATERIALS[0],
    level: 250,
    part: "",
    doubleUpgrade: false,
    currentValue: 0,
    legendaryValue: 0,
    buyCost: 0,
    extraCost: 0,
    pityConfirmedManual: false,
    options: [],
  };
}

function costPerRoll(
  materialType: MATERIAL_TYPE,
  level: number,
  grade: POTENTIAL_GRADE,
) {
  const materials = calcRollingMaterials(
    materialType,
    level,
    isAddi(materialType),
    grade,
  );
  return materials.find((m) => m.name.startsWith("메소"))?.value ?? 0;
}

const selectComponents: SelectComponentsConfig<
  OptionSelectItem,
  false,
  GroupBase<OptionSelectItem>
> = {
  Option: ({ children, ...props }) => (
    <chakraComponents.Option {...props}>
      {children}
      <Box flex={1} />
      {[...props.data.grades].map((grade) => (
        <Image key={grade} src={getPotentialIcon(grade)} boxSize={4} />
      ))}
    </chakraComponents.Option>
  ),
};

interface GroupContext {
  isGrouped: boolean;
  isTarget: boolean;
  sharedGuarantee: number;
  bound: number;
  sMax: number;
}

interface CandidateResult {
  deltaE: number;
  guaranteed: boolean;
  cost: number;
}

function CandidateCard({
  candidate,
  groupCtx,
  taxRate,
  isRecommended,
  onChange,
  onDelete,
  onResult,
}: {
  candidate: Candidate;
  groupCtx: GroupContext;
  taxRate: number;
  isRecommended: boolean;
  onChange: (patch: Partial<Candidate>) => void;
  onDelete: () => void;
  onResult: (r: CandidateResult) => void;
}) {
  const { data } = usePotentialQuery({
    type: MATERIAL_INFOS[candidate.materialType].type,
    part: candidate.part,
    level: candidate.level,
  });

  const conditionInfos = useMemo(() => calcConditionInfos(data ?? []), [data]);
  const nameOptions: OptionSelectItem[] = Object.entries(conditionInfos).map(
    ([name, infosByName]) => ({
      label: name,
      value: name,
      grades: Object.values(infosByName).reduce<Set<string>>(
        (acc, infosByValue) => {
          Object.keys(infosByValue).forEach((g) => acc.add(g));
          return acc;
        },
        new Set<string>(),
      ),
    }),
  );

  const criteria =
    POTENTIAL_CRITERIA[candidate.materialType]?.[POTENTIAL_GRADE.UNIQUE];
  const baseUpgradeChance = criteria
    ? Math.min(criteria.upgrade * (candidate.doubleUpgrade ? 2 : 1), 1)
    : 0;

  const guaranteed = groupCtx.isGrouped
    ? groupCtx.bound > 0 && groupCtx.sharedGuarantee >= groupCtx.bound - 1
    : candidate.pityConfirmedManual;

  const effectiveProb = guaranteed ? 1 : baseUpgradeChance;

  const uniqueGradeName = POTENTIAL_INFOS[POTENTIAL_GRADE.UNIQUE].name;
  const probabilityOf = (name: string, value: number) => {
    const infosByName = conditionInfos[name];
    if (!infosByName || !infosByName[value]) return 0;
    const grades = new Set(Object.keys(infosByName[value]));
    const prob = calcProbabilityByConditions(data ?? [], conditionInfos, [
      { name, value, grades },
    ]);
    return prob[uniqueGradeName] ?? 0;
  };

  const ceilingPenalty =
    groupCtx.isGrouped && !groupCtx.isTarget
      ? groupCtx.sharedGuarantee * groupCtx.sMax
      : 0;
  const stackBonus =
    groupCtx.isGrouped && !groupCtx.isTarget
      ? (1 - effectiveProb) * groupCtx.sMax
      : 0;

  const netLGain =
    (1 - taxRate) * candidate.legendaryValue -
    candidate.currentValue -
    candidate.buyCost -
    ceilingPenalty;
  const expectedL = effectiveProb * Math.max(0, netLGain);

  // 옵션은 "이번 굴리기에서 승급하지 않았을 때"만 나올 수 있으므로 (1-effectiveProb)를 곱함
  const expectedOpts = guaranteed
    ? 0
    : (1 - effectiveProb) *
      candidate.options.reduce((sum, o) => {
        const prob = probabilityOf(o.name, o.value);
        const netOptGain =
          (1 - taxRate) * o.userValue -
          candidate.currentValue -
          candidate.buyCost;
        return netOptGain > 0 ? sum + prob * netOptGain : sum;
      }, 0);

  const cost =
    costPerRoll(
      candidate.materialType,
      candidate.level,
      POTENTIAL_GRADE.UNIQUE,
    ) + candidate.extraCost;
  const deltaE = expectedL + expectedOpts + stackBonus - cost;

  useEffect(() => {
    onResult({ deltaE, guaranteed, cost });
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [deltaE, guaranteed, cost]);

  const addOptionRow = (name: string) => {
    const infosByName = conditionInfos[name];
    if (!infosByName) return;
    const value = Number(Object.keys(infosByName)[0]);
    onChange({
      options: [
        ...candidate.options,
        { id: Math.random().toString(36).slice(2), name, value, userValue: 0 },
      ],
    });
  };
  const updateOptionRow = (id: string, patch: Partial<GameOptionRow>) => {
    onChange({
      options: candidate.options.map((o) =>
        o.id == id ? { ...o, ...patch } : o,
      ),
    });
  };
  const deleteOptionRow = (id: string) => {
    onChange({ options: candidate.options.filter((o) => o.id != id) });
  };

  return (
    <Box
      borderWidth={2}
      borderColor={isRecommended ? "green.400" : "inherit"}
      borderRadius={8}
      p={3}
      position="relative"
    >
      <IconButton
        aria-label="delete"
        icon={<LuTrash2 size={14} />}
        size="xs"
        position="absolute"
        top={2}
        right={2}
        variant="ghost"
        colorScheme="red"
        onClick={onDelete}
      />
      <Stack gap={2}>
        <Flex align="center" gap={2}>
          <Input
            size="sm"
            width="200px"
            value={candidate.label}
            onChange={(e) => onChange({ label: e.target.value })}
          />
          {isRecommended && <Badge colorScheme="green">추천</Badge>}
          {groupCtx.isGrouped && groupCtx.isTarget && (
            <Badge colorScheme="purple">최종 목표</Badge>
          )}
          {groupCtx.isGrouped && !groupCtx.isTarget && <Badge>제물 후보</Badge>}
        </Flex>

        <Flex gap={2} wrap="wrap" align="center">
          <NativeSelect
            size="sm"
            width="180px"
            value={candidate.materialType}
            isDisabled={!!candidate.groupId}
            onChange={(e) =>
              onChange({ materialType: e.target.value as MATERIAL_TYPE })
            }
          >
            {SELECTABLE_MATERIALS.map((m) => (
              <option key={m} value={m}>
                {MATERIAL_INFOS[m].name}
              </option>
            ))}
          </NativeSelect>
          <Input
            size="sm"
            width="100px"
            placeholder="부위 (예: 모자)"
            value={candidate.part}
            onChange={(e) => onChange({ part: e.target.value })}
          />
          <NumberInput
            size="sm"
            width="90px"
            value={candidate.level}
            onChange={(_, v) => onChange({ level: isNaN(v) ? 0 : v })}
            min={0}
          >
            <NumberInputField placeholder="레벨" />
          </NumberInput>
          <Checkbox
            size="sm"
            isChecked={candidate.doubleUpgrade}
            onChange={(e) => onChange({ doubleUpgrade: e.target.checked })}
          >
            미라클
          </Checkbox>
        </Flex>

        {!groupCtx.isGrouped && (
          <Checkbox
            size="sm"
            isChecked={candidate.pityConfirmedManual}
            onChange={(e) =>
              onChange({ pityConfirmedManual: e.target.checked })
            }
          >
            다음 1회로 천장 확정 (등급업 100%)
          </Checkbox>
        )}
        {groupCtx.isGrouped && (
          <Text fontSize="xs" color={guaranteed ? "orange.400" : "gray.500"}>
            {guaranteed
              ? "그룹 공유 천장 기준 → 이번 굴리기 등급업 확정"
              : `그룹 공유 천장 기준 → 등급업 확률 ${(effectiveProb * 100).toFixed(3)}%`}
          </Text>
        )}

        <Flex gap={2} wrap="wrap" align="center">
          <Text fontSize="xs" whiteSpace="nowrap">
            현재 옵션 가치 (V_U)
          </Text>
          <NumberInput
            size="sm"
            width="130px"
            value={candidate.currentValue}
            onChange={(_, v) => onChange({ currentValue: isNaN(v) ? 0 : v })}
          >
            <NumberInputField />
          </NumberInput>

          <Text fontSize="xs" whiteSpace="nowrap">
            레전드리 가치 (V_L)
          </Text>
          <NumberInput
            size="sm"
            width="130px"
            value={candidate.legendaryValue}
            onChange={(_, v) => onChange({ legendaryValue: isNaN(v) ? 0 : v })}
          >
            <NumberInputField />
          </NumberInput>

          <Text fontSize="xs" whiteSpace="nowrap">
            제물 구입비
          </Text>
          <NumberInput
            size="sm"
            width="130px"
            value={candidate.buyCost}
            onChange={(_, v) => onChange({ buyCost: isNaN(v) ? 0 : v })}
          >
            <NumberInputField />
          </NumberInput>

          <Text fontSize="xs" whiteSpace="nowrap">
            감정비 등 추가비용
          </Text>
          <NumberInput
            size="sm"
            width="130px"
            value={candidate.extraCost}
            onChange={(_, v) => onChange({ extraCost: isNaN(v) ? 0 : v })}
          >
            <NumberInputField />
          </NumberInput>
        </Flex>

        {!guaranteed && (
          <Stack gap={1}>
            <Text fontSize="xs" fontWeight="bold">
              유효 옵션 목록
            </Text>
            {candidate.options.map((o) => {
              const valueOptions: OptionSelectItem[] = conditionInfos[o.name]
                ? Object.entries(conditionInfos[o.name]).map(
                    ([v, infosByValue]) => ({
                      label: v,
                      value: v,
                      grades: new Set(Object.keys(infosByValue)),
                    }),
                  )
                : [];
              const prob = probabilityOf(o.name, o.value);

              return (
                <Flex key={o.id} gap={2} align="center" wrap="wrap">
                  <Box minW="200px">
                    <Select
                      size="sm"
                      components={selectComponents}
                      value={{
                        label: o.name,
                        value: o.name,
                        grades:
                          nameOptions.find((n) => n.value === o.name)?.grades ??
                          new Set(),
                      }}
                      options={nameOptions}
                      onChange={(opt) =>
                        opt && updateOptionRow(o.id, { name: opt.value })
                      }
                    />
                  </Box>
                  <Box minW="100px">
                    <Select
                      size="sm"
                      components={selectComponents}
                      value={{
                        label: o.value.toString(),
                        value: o.value.toString(),
                        grades: new Set(
                          conditionInfos[o.name]?.[o.value]
                            ? Object.keys(conditionInfos[o.name][o.value])
                            : [],
                        ),
                      }}
                      options={valueOptions}
                      onChange={(opt) =>
                        opt &&
                        updateOptionRow(o.id, { value: Number(opt.value) })
                      }
                    />
                  </Box>
                  <Text fontSize="xs" whiteSpace="nowrap">
                    확률: {(prob * 100).toFixed(3)}%
                  </Text>
                  <Text fontSize="xs" whiteSpace="nowrap">
                    가치
                  </Text>
                  <NumberInput
                    size="sm"
                    width="120px"
                    value={o.userValue}
                    onChange={(_, v) =>
                      updateOptionRow(o.id, { userValue: isNaN(v) ? 0 : v })
                    }
                  >
                    <NumberInputField />
                  </NumberInput>
                  <IconButton
                    aria-label="delete-option"
                    icon={<LuTrash2 size={12} />}
                    size="xs"
                    variant="ghost"
                    colorScheme="red"
                    onClick={() => deleteOptionRow(o.id)}
                  />
                </Flex>
              );
            })}
            <Box minW="200px">
              <Select
                size="sm"
                components={selectComponents}
                placeholder="옵션 추가..."
                value={null}
                options={nameOptions}
                onChange={(opt) => opt && addOptionRow(opt.value)}
              />
            </Box>
          </Stack>
        )}

        <Box pt={2} borderTopWidth={1}>
          {groupCtx.isGrouped && !groupCtx.isTarget && (
            <Text fontSize="xs" color="gray.500">
              (공유 스택 위험 차감: -
              {Math.round(ceilingPenalty).toLocaleString()} / 안전 보너스: +
              {Math.round(stackBonus).toLocaleString()})
            </Text>
          )}
          <Text fontSize="xs" color="gray.500">
            1회 비용: {Math.round(cost).toLocaleString()}
          </Text>
          <Text fontSize="sm">
            ΔE (기대손익): <b>{Math.round(deltaE).toLocaleString()}</b>
          </Text>
        </Box>
      </Stack>
    </Box>
  );
}

export default function Strategy() {
  const [candidates, setCandidates] = useState<Candidate[]>([
    createCandidate(),
  ]);
  const [groups, setGroups] = useState<PityGroup[]>([]);
  const [taxRate, setTaxRate] = useState(5);
  const [resultsMap, setResultsMap] = useState<Record<string, CandidateResult>>(
    {},
  );

  const updateCandidate = (id: string, patch: Partial<Candidate>) => {
    setCandidates((prev) =>
      prev.map((c) => (c.id == id ? { ...c, ...patch } : c)),
    );
  };

  const addGroup = () => {
    setGroups((prev) => [
      ...prev,
      {
        id: Math.random().toString(36).slice(2),
        materialType: SELECTABLE_MATERIALS[0],
        grade: POTENTIAL_GRADE.UNIQUE,
        sharedGuarantee: 0,
      },
    ]);
  };
  const removeGroup = (groupId: string) => {
    setGroups((prev) => prev.filter((g) => g.id != groupId));
    setCandidates((prev) =>
      prev.map((c) =>
        c.groupId == groupId ? { ...c, groupId: undefined } : c,
      ),
    );
  };
  const toggleMember = (
    group: PityGroup,
    candidateId: string,
    checked: boolean,
  ) => {
    setCandidates((prev) =>
      prev.map((c) =>
        c.id == candidateId
          ? { ...c, groupId: checked ? group.id : undefined }
          : c,
      ),
    );
    if (!checked) {
      setGroups((prev) =>
        prev.map((g) =>
          g.id == group.id && g.targetId == candidateId
            ? { ...g, targetId: undefined }
            : g,
        ),
      );
    }
  };

  const groupContextFor = (candidate: Candidate): GroupContext => {
    const group = groups.find((g) => g.id == candidate.groupId);
    if (!group) {
      return {
        isGrouped: false,
        isTarget: false,
        sharedGuarantee: 0,
        bound: 0,
        sMax: 0,
      };
    }
    const criteria = POTENTIAL_CRITERIA[group.materialType]?.[group.grade];
    const bound = criteria?.bound ?? -1;
    const target = candidates.find((c) => c.id == group.targetId);
    const sMax =
      target && bound > 0
        ? ((1 - taxRate / 100) * target.legendaryValue - target.currentValue) /
          bound
        : 0;
    return {
      isGrouped: true,
      isTarget: candidate.id == group.targetId,
      sharedGuarantee: group.sharedGuarantee,
      bound,
      sMax,
    };
  };

  const recommendedId = useMemo(() => {
    const list = candidates
      .filter((c) => resultsMap[c.id])
      .map((c) => ({ id: c.id, ...resultsMap[c.id] }));
    if (!list.length) return undefined;
    return list.reduce((best, cur) => (cur.deltaE > best.deltaE ? cur : best))
      .id;
  }, [candidates, resultsMap]);

  return (
    <BoardCard order={1} title="전략 계산기">
      <Stack gap={4} width={{ base: "100%", md: "container.md" }}>
        <Text fontSize="sm" color="gray.500">
          지금 재설정 1회를 어느 장비에 쓰는 게 유리한지 계산합니다. 같은
          재료+등급인 장비들은 아래 "공유 천장 그룹"으로 묶고, 그 중 최종
          목표(무기 등)를 지정하면 잘못된 등급업으로 스택이 날아가는 위험까지
          반영해서 계산합니다.
        </Text>

        <Flex align="center" gap={2}>
          <Text fontSize="sm" whiteSpace="nowrap">
            거래 수수료(%)
          </Text>
          <NumberInput
            size="sm"
            width="100px"
            value={taxRate}
            onChange={(_, v) => setTaxRate(isNaN(v) ? 0 : v)}
            min={0}
            max={100}
          >
            <NumberInputField />
          </NumberInput>
        </Flex>

        <Text fontWeight="bold">공유 천장 그룹</Text>
        {groups.map((group) => {
          const members = candidates.filter((c) => c.groupId == group.id);
          return (
            <Box
              key={group.id}
              borderWidth={1}
              borderRadius={8}
              p={3}
              position="relative"
            >
              <IconButton
                aria-label="delete-group"
                icon={<LuTrash2 size={14} />}
                size="xs"
                position="absolute"
                top={2}
                right={2}
                variant="ghost"
                colorScheme="red"
                onClick={() => removeGroup(group.id)}
              />
              <Stack gap={2}>
                <Flex gap={2} wrap="wrap" align="center">
                  <NativeSelect
                    size="sm"
                    width="180px"
                    value={group.materialType}
                    onChange={(e) =>
                      setGroups((prev) =>
                        prev.map((g) =>
                          g.id == group.id
                            ? {
                                ...g,
                                materialType: e.target.value as MATERIAL_TYPE,
                              }
                            : g,
                        ),
                      )
                    }
                  >
                    {SELECTABLE_MATERIALS.map((m) => (
                      <option key={m} value={m}>
                        {MATERIAL_INFOS[m].name}
                      </option>
                    ))}
                  </NativeSelect>
                  <NativeSelect
                    size="sm"
                    width="120px"
                    value={group.grade}
                    onChange={(e) =>
                      setGroups((prev) =>
                        prev.map((g) =>
                          g.id == group.id
                            ? { ...g, grade: e.target.value as POTENTIAL_GRADE }
                            : g,
                        ),
                      )
                    }
                  >
                    {GRADES.filter((g) => g != POTENTIAL_GRADE.LENGENDARY).map(
                      (g) => (
                        <option key={g} value={g}>
                          {POTENTIAL_INFOS[g].name}
                        </option>
                      ),
                    )}
                  </NativeSelect>
                  <Text fontSize="xs" whiteSpace="nowrap">
                    공유 천장 스택
                  </Text>
                  <NumberInput
                    size="sm"
                    width="120px"
                    value={group.sharedGuarantee}
                    onChange={(_, v) =>
                      setGroups((prev) =>
                        prev.map((g) =>
                          g.id == group.id
                            ? { ...g, sharedGuarantee: isNaN(v) ? 0 : v }
                            : g,
                        ),
                      )
                    }
                    min={0}
                  >
                    <NumberInputField />
                  </NumberInput>
                </Flex>

                <Text fontSize="xs" fontWeight="bold">
                  그룹 멤버 (전체 장비 목록에서 선택)
                </Text>
                <Stack gap={1}>
                  {candidates.map((c) => {
                    const checked = c.groupId == group.id;
                    return (
                      <Checkbox
                        key={c.id}
                        size="sm"
                        isChecked={checked}
                        isDisabled={!!c.groupId && !checked}
                        onChange={(e) =>
                          toggleMember(group, c.id, e.target.checked)
                        }
                      >
                        {c.label}
                      </Checkbox>
                    );
                  })}
                </Stack>

                {!!members.length && (
                  <>
                    <Text fontSize="xs" fontWeight="bold">
                      최종 목표(스택을 진짜로 쓸 장비)
                    </Text>
                    <RadioGroup
                      value={group.targetId ?? ""}
                      onChange={(v) =>
                        setGroups((prev) =>
                          prev.map((g) =>
                            g.id == group.id ? { ...g, targetId: v } : g,
                          ),
                        )
                      }
                    >
                      <Stack gap={1}>
                        {members.map((m) => (
                          <Radio key={m.id} size="sm" value={m.id}>
                            {m.label}
                          </Radio>
                        ))}
                      </Stack>
                    </RadioGroup>
                  </>
                )}
              </Stack>
            </Box>
          );
        })}
        <Button size="sm" leftIcon={<LuPlus />} onClick={addGroup}>
          공유 천장 그룹 추가
        </Button>

        <Text fontWeight="bold" pt={2}>
          장비 목록
        </Text>
        {candidates.map((c) => (
          <CandidateCard
            key={c.id}
            candidate={c}
            groupCtx={groupContextFor(c)}
            taxRate={taxRate / 100}
            isRecommended={recommendedId == c.id}
            onChange={(patch) => updateCandidate(c.id, patch)}
            onDelete={() =>
              setCandidates((prev) => prev.filter((x) => x.id != c.id))
            }
            onResult={(r) => setResultsMap((prev) => ({ ...prev, [c.id]: r }))}
          />
        ))}

        <Button
          size="sm"
          leftIcon={<LuPlus />}
          onClick={() => setCandidates((prev) => [...prev, createCandidate()])}
        >
          장비 추가
        </Button>
      </Stack>
    </BoardCard>
  );
}
